<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33000000"> <!-- Efeito de toque cinza suave sobre o botão branco -->
    <item>
        <layer-list>
            <!-- Anel externo do obturador -->
            <item>
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="#FFFFFF" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <!-- Círculo interno branco sólido -->
            <item
                android:top="8dp"
                android:bottom="8dp"
                android:start="8dp"
                android:end="8dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>