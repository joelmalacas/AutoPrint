<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- ================= PRÉ-VISUALIZAÇÃO DA CÂMARA ================= -->
    <!-- PreviewView é o componente do CameraX que mostra a imagem em direto -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fillCenter"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= GRELHA DE COMPOSIÇÃO (regra dos terços) ================= -->
    <!-- Escondida por defeito; a MainActivity mostra-a consoante a definição "Mostrar grelha" -->
    <com.example.autoprint.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/viewFinder"
        app:layout_constraintBottom_toBottomOf="@id/viewFinder"
        app:layout_constraintStart_toStartOf="@id/viewFinder"
        app:layout_constraintEnd_toEndOf="@id/viewFinder" />

    <!-- ================= GRADIENTE SUPERIOR (contraste dos ícones) ================= -->
    <View
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:background="@drawable/gradient_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= GRADIENTE INFERIOR (contraste dos controlos) ================= -->
    <View
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ================= BARRA SUPERIOR: flash / definições ================= -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_control_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="Alternar flash"
            android:stateListAnimator="@animator/small_button_press" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="A câmara está pronta"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_control_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings"
            android:contentDescription="Definições"
            android:stateListAnimator="@animator/small_button_press" />

    </LinearLayout>

    <!-- ================= RETÍCULO DE FOCO (aparece ao tocar no ecrã) ================= -->
    <!-- Controlado a partir do código: tornar visível + animar alfa/escala no toque -->
    <View
        android:id="@+id/focusReticle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/focus_reticle"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ================= BARRA INFERIOR: galeria / captura / trocar câmara ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Miniatura da galeria (última foto tirada) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/galleryThumbnail"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#33FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="34dp"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/imgThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gallery_placeholder"
                android:contentDescription="Abrir galeria" />

        </androidx.cardview.widget.CardView>

        <!-- Anel de pulsação por trás do botão de captura (animação em loop) -->
        <View
            android:id="@+id/captureRing"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:background="@drawable/capture_button_ring"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botão principal de captura -->
        <ImageButton
            android:id="@+id/btnCapture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/capture_button_background"
            android:src="@null"
            android:contentDescription="Tirar fotografia"
            android:stateListAnimator="@animator/capture_button_press"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botão para trocar câmara frontal/traseira -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:fabCustomSize="52dp"
            app:maxImageSize="26dp"
            app:backgroundTint="#33FFFFFF"
            app:tint="#FFFFFF"
            app:elevation="0dp"
            app:borderWidth="0dp"
            app:rippleColor="#55FFFFFF"
            app:srcCompat="@drawable/ic_switch_camera"
            android:contentDescription="Trocar câmara"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="34dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ================= FLASH DE CAPTURA (efeito de disparo) ================= -->
    <!-- View branca que fica invisível; no código faz-se um fade in/out rápido ao tirar a foto -->
    <View
        android:id="@+id/captureFlashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
